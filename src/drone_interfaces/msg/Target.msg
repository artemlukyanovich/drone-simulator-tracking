# Цель слежения, публикуемая detector_node для follower_node (Фаза 3).
# Координаты нормализованы и не зависят от разрешения камеры — P-коэффициенты
# контроллера остаются валидными при смене размера кадра.

std_msgs/Header header   # стамп кадра — контроллер по нему определяет свежесть цели (staleness)
bool    detected         # есть ли цель в кадре прямо сейчас
float32 offset_x         # [-1..1] смещение центра bbox от центра кадра по X (право > 0)
float32 offset_y         # [-1..1] по Y (вниз > 0); в MVP не используется, зарезервировано под высоту
float32 area_ratio       # [0..1] доля площади кадра под bbox — прокси дистанции до цели
