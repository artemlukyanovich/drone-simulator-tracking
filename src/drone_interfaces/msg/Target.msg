# Цель слежения, публикуемая detector_node для follower_node (Фаза 3).
# Координаты нормализованы и не зависят от разрешения камеры — P-коэффициенты
# контроллера остаются валидными при смене размера кадра.

std_msgs/Header header   # стамп кадра — контроллер по нему определяет свежесть цели (staleness)
bool    detected         # есть ли цель в кадре прямо сейчас
float32 offset_x         # [-1..1] смещение центра bbox от центра кадра по X (право > 0)
float32 offset_y         # [-1..1] по Y (вниз > 0); в MVP не используется, зарезервировано под высоту
float32 area_ratio       # [0..1] доля площади кадра под bbox — прокси дистанции до цели

# Фаза 4. Поля добавлены в КОНЕЦ (ABI-совместимо, §Ф4-3): потребители Фазы 3 не ломаются.
int32   track_id         # ВРЕМЕННЫЙ id от трекера (ByteTrack); -1 = нет/не назначен.
                         # Меняется после каждой потери трека — на него нельзя опираться
                         # как на «личность» цели, он лишь показывает текущий трек.
float32 distance_m       # оценка дистанции до цели в метрах (pinhole, M3/Ф4-5); 0 = нет оценки

# Инкремент 7A (M2 / Ф4-13). Тоже в конец — ABI-совместимо.
int32   object_id        # ПОСТОЯННЫЙ id сопровождаемого человека; -1 = цель не захвачена.
                         # Присваивается при захвате облика и НЕ меняется при перезахвате:
                         # track_id может стать другим, object_id останется прежним. Это и
                         # есть «кого мы ведём» — для оверлея, телеметрии (M6) и логов.
