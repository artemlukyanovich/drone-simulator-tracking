<?xml version="1.0" encoding="UTF-8"?>
<!--
  follow_crowd.sdf — мир Фазы 4 (Инкремент 5 / M1) для проверки МУЛЬТИТРЕКИНГА.

  Клон follow_target.sdf (тот же PX4-совместимый каркас: все системные плагины,
  физика, земля, солнце, spherical_coordinates; имя <world> — "default", иначе
  gz_bridge не найдёт /world/default/* сенсорику — см. follow_target.sdf). Механизм
  запуска НЕ меняется: standalone (WORLD=…/follow_crowd.sdf scripts/run_px4_sitl.sh).
  follow_target.sdf НЕ трогаем — он остаётся регресс-эталоном 4B (§Ф4-10).

  Отличие от follow_target.sdf: вместо ОДНОГО actor'а — ТРИ ходячих человека
  (1 цель + 2 дистрактора). Дистракторы — суть проверки трекинга: без них ID-логика
  (захват одного track_id, удержание на пересечениях) не демонстрируется.

  Геометрия (дрон стартует в (0,0,0) носом на +X, камера смотрит вперёд горизонтально):
    * target_person — БЛИЖНИЙ круг: центр (7,0), R=2.5 (x:4.5..9.5). Стартует в ближней
      точке (4.5,0) ~4.5 м от дрона → на старте детекции это КРУПНЕЙШИЙ bbox, поэтому
      политика lock (крупнейший подтверждённый трек, Ф4-2) захватывает именно его.
    * distractor_1 / distractor_2 — ФОНОВЫЕ круги дальше по +X (центры (10,0)/(11,0),
      R=4/4.5). Дальше цели → мельче в кадре → не перехватывают начальный захват. Разные
      периоды (72/60/54 с) → фазы пересечений «плывут»: дистракторы регулярно проходят
      по азимуту цели (дрон держит цель в центре кадра) → их боксы ПЕРЕСЕКАЮТ залоченный
      в кадре — стресс для ByteTrack (риск R1). Все круги СМЕЩЕНЫ от старта дрона (урок
      Ф3-6: орбита вокруг дрона дала бы спин на месте).

  actor'ы: скелетная анимация walk.dae + <script><trajectory> (штатный механизм Gazebo,
  без плагинов). Меш — Fuel Mingfei/actor (кэш ~/.gz/fuel, в git не коммитим). z=1.0 —
  начало скелета на бёдрах, ступни на земле. У <actor> нет физики/коллизий — чисто
  визуальная цель, что камере/детектору и нужно. Траектории ЗАМКНУТЫ (t_конца совпадает
  с t=0 по позиции) → loop без телепорта; yap растёт непрерывно (+2π за круг) → плавно.

  Гейт M1: дрон стабильно ведёт ОДНОГО (target_person); track_id не скачет на
  пересечениях; при уходе дистракторов из кадра залоченный сохраняется.
-->
<sdf version="1.9">
  <world name="default">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>
    <plugin name="gz::sim::systems::Imu" filename="gz-sim-imu-system"/>
    <plugin name="gz::sim::systems::AirPressure" filename="gz-sim-air-pressure-system"/>
    <plugin name="gz::sim::systems::ApplyLinkWrench" filename="gz-sim-apply-link-wrench-system"/>
    <plugin name="gz::sim::systems::NavSat" filename="gz-sim-navsat-system"/>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>
    <gui fullscreen="false">
      <!-- 3D scene -->
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.4 0.4 0.4</ambient_light>
        <background_color>0.8 0.8 0.8</background_color>
        <camera_pose>-6 0 6 0 0.5 0</camera_pose>
        <camera_clip>
          <near>0.25</near>
          <far>25000</far>
        </camera_clip>
      </plugin>
      <!-- Plugins that add functionality to the scene -->
      <plugin filename="EntityContextMenuPlugin" name="Entity context menu">
        <gz-gui>
          <property key="state" type="string">floating</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="CameraTracking" name="Camera Tracking">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="MarkerManager" name="Marker manager">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="SelectEntities" name="Select Entities">
        <gz-gui>
          <anchors target="Select entities">
            <line own="right" target="right"/>
            <line own="top" target="top"/>
          </anchors>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="VisualizationCapabilities" name="Visualization Capabilities">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="Spawn" name="Spawn Entities">
        <gz-gui>
          <anchors target="Select entities">
            <line own="right" target="right"/>
            <line own="top" target="top"/>
          </anchors>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin name="World control" filename="WorldControl">
        <gz-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">0</property>
          <property type="bool" key="resizable">0</property>
          <property type="double" key="height">72</property>
          <property type="double" key="width">121</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <play_pause>1</play_pause>
        <step>1</step>
        <start_paused>1</start_paused>
      </plugin>
      <plugin name="World stats" filename="WorldStats">
        <gz-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">0</property>
          <property type="bool" key="resizable">0</property>
          <property type="double" key="height">110</property>
          <property type="double" key="width">290</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <sim_time>1</sim_time>
        <real_time>1</real_time>
        <real_time_factor>1</real_time_factor>
        <iterations>1</iterations>
      </plugin>
      <plugin name="Entity tree" filename="EntityTree"/>
    </gui>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <grid>false</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1 1</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
        <pose>0 0 0 0 -0 0</pose>
        <inertial>
          <pose>0 0 0 0 -0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <enable_wind>false</enable_wind>
      </link>
      <pose>0 0 0 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>
    <light name="sunUTC" type="directional">
      <pose>0 0 500 0 -0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>0.904 0.904 0.904 1</diffuse>
      <specular>0.271 0.271 0.271 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>

    <!-- ЦЕЛЬ (target_person) — БЛИЖНИЙ круг: центр (7,0), R=2.5 (x:4.5..9.5, y:-2.5..2.5).
         Старт в ближней точке (4.5,0) ~4.5 м от дрона → крупнейший bbox на момент захвата
         → политика lock (Ф4-2) берёт именно его. Скорость ~0.22 м/с (2πR≈15.7 м / 72 с) —
         как в 4B, медленно, чтобы forward-канал успевал. yaw=φ+90° непрерывно растёт
         (4.712→10.996 = +2π) → плавно; траектория замкнута (t=72 == t=0) → loop без телепорта.
         Механизм/меш/z — как в follow_target.sdf (walk.dae из Fuel, z=1.0, без физики). -->
    <actor name="target_person">
      <skin>
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walk">
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>0.0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walk" tension="0.6">
          <waypoint><time>0</time>  <pose>4.50   0.00 1.0 0 0 4.712</pose></waypoint>
          <waypoint><time>9</time>  <pose>5.23  -1.77 1.0 0 0 5.498</pose></waypoint>
          <waypoint><time>18</time> <pose>7.00  -2.50 1.0 0 0 6.283</pose></waypoint>
          <waypoint><time>27</time> <pose>8.77  -1.77 1.0 0 0 7.069</pose></waypoint>
          <waypoint><time>36</time> <pose>9.50   0.00 1.0 0 0 7.854</pose></waypoint>
          <waypoint><time>45</time> <pose>8.77   1.77 1.0 0 0 8.639</pose></waypoint>
          <waypoint><time>54</time> <pose>7.00   2.50 1.0 0 0 9.425</pose></waypoint>
          <waypoint><time>63</time> <pose>5.23   1.77 1.0 0 0 10.210</pose></waypoint>
          <waypoint><time>72</time> <pose>4.50   0.00 1.0 0 0 10.996</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <!-- ДИСТРАКТОР 1 — ФОНОВЫЙ круг: центр (10,0), R=4 (x:6..14). Дальше цели → мельче в
         кадре → не перехватывает захват. Период 60 с (2πR≈25.1 м / 60 → 0.42 м/с). Старт в
         дальней точке (14,0). Проходя по y, регулярно пересекает азимут цели → его бокс
         «наезжает» на залоченный в кадре (стресс ByteTrack). yaw=φ+90° непрерывно (1.571→7.854). -->
    <actor name="distractor_1">
      <skin>
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walk">
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>0.0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walk" tension="0.6">
          <waypoint><time>0</time>    <pose>14.00  0.00 1.0 0 0 1.571</pose></waypoint>
          <waypoint><time>7.5</time>  <pose>12.83  2.83 1.0 0 0 2.356</pose></waypoint>
          <waypoint><time>15</time>   <pose>10.00  4.00 1.0 0 0 3.142</pose></waypoint>
          <waypoint><time>22.5</time> <pose>7.17   2.83 1.0 0 0 3.927</pose></waypoint>
          <waypoint><time>30</time>   <pose>6.00   0.00 1.0 0 0 4.712</pose></waypoint>
          <waypoint><time>37.5</time> <pose>7.17  -2.83 1.0 0 0 5.498</pose></waypoint>
          <waypoint><time>45</time>   <pose>10.00 -4.00 1.0 0 0 6.283</pose></waypoint>
          <waypoint><time>52.5</time> <pose>12.83 -2.83 1.0 0 0 7.069</pose></waypoint>
          <waypoint><time>60</time>   <pose>14.00  0.00 1.0 0 0 7.854</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <!-- ДИСТРАКТОР 2 — ФОНОВЫЙ круг: центр (11,0), R=4.5 (x:6.5..15.5). Период 54 с
         (2πR≈28.3 м / 54 → 0.52 м/с). Старт сбоку (11,4.5). Разные периоды цели/дистракторов
         (72/60/54) → фазы пересечений «плывут», не повторяются синхронно. yaw=φ+90° (3.142→9.425). -->
    <actor name="distractor_2">
      <skin>
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walk">
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>0.0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walk" tension="0.6">
          <waypoint><time>0</time>     <pose>11.00  4.50 1.0 0 0 3.142</pose></waypoint>
          <waypoint><time>6.75</time>  <pose>7.82   3.18 1.0 0 0 3.927</pose></waypoint>
          <waypoint><time>13.5</time>  <pose>6.50   0.00 1.0 0 0 4.712</pose></waypoint>
          <waypoint><time>20.25</time> <pose>7.82  -3.18 1.0 0 0 5.498</pose></waypoint>
          <waypoint><time>27</time>    <pose>11.00 -4.50 1.0 0 0 6.283</pose></waypoint>
          <waypoint><time>33.75</time> <pose>14.18 -3.18 1.0 0 0 7.069</pose></waypoint>
          <waypoint><time>40.5</time>  <pose>15.50  0.00 1.0 0 0 7.854</pose></waypoint>
          <waypoint><time>47.25</time> <pose>14.18  3.18 1.0 0 0 8.639</pose></waypoint>
          <waypoint><time>54</time>    <pose>11.00  4.50 1.0 0 0 9.425</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg> 8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>
  </world>
</sdf>
