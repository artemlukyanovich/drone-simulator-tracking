<?xml version="1.0" encoding="UTF-8"?>
<!--
  follow_target.sdf — мир Фазы 3 для слежения за человеком.

  Это НАШ ассет (в git проекта), а не файл PX4. Создан как копия штатного
  PX4 default.sdf (Tools/simulation/gz/worlds/default.sdf, BSD-3-Clause) —
  чтобы сохранить ВСЕ системные плагины, которые ждёт PX4 (Physics, Sensors,
  Imu, AirPressure, NavSat, Contact, ApplyLinkWrench, UserCommands,
  SceneBroadcaster), физику, землю, солнце и spherical_coordinates. Без них
  PX4 не получит сенсорику.

  Отличие от default.sdf:
    * добавлена цель — модель человека из Gazebo Fuel (скачивается и кэшируется
      при первом запуске; в репозиторий не коммитится, только URI).

  ВАЖНО: имя мира — именно "default". В standalone-режиме PX4 пропускает блок
  определения имени работающего мира (px4-rc.simulator), и PX4_GZ_WORLD остаётся
  "default" (его жёстко задаёт make-цель gz_x500_mono_cam), а gz_bridge цепляется к
  топикам /world/default/*. Назови мир иначе — мост не найдёт сенсорику. Поэтому
  имя файла описательное (follow_target.sdf), а имя <world> — "default".

  Запуск — standalone: мир поднимаем сами (scripts/run_px4_sitl.sh WORLD=…),
  PX4 подключается к работающему Gazebo (PX4_GZ_STANDALONE). Подробности —
  docs/phase3_setup.md, инкремент 1.

  Инкремент 1 (де-риск): цель СТАТИЧНА (Standing person) — проверяем, что YOLO
  её детектит. Ходячий actor с траекторией придёт позже (инкремент 4) правкой
  этого же файла, без смены механизма запуска.
-->
<sdf version="1.9">
  <world name="default">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>
    <plugin name="gz::sim::systems::Imu" filename="gz-sim-imu-system"/>
    <plugin name="gz::sim::systems::AirPressure" filename="gz-sim-air-pressure-system"/>
    <plugin name="gz::sim::systems::ApplyLinkWrench" filename="gz-sim-apply-link-wrench-system"/>
    <plugin name="gz::sim::systems::NavSat" filename="gz-sim-navsat-system"/>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>
    <gui fullscreen="false">
      <!-- 3D scene -->
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.4 0.4 0.4</ambient_light>
        <background_color>0.8 0.8 0.8</background_color>
        <camera_pose>-6 0 6 0 0.5 0</camera_pose>
        <camera_clip>
          <near>0.25</near>
          <far>25000</far>
        </camera_clip>
      </plugin>
      <!-- Plugins that add functionality to the scene -->
      <plugin filename="EntityContextMenuPlugin" name="Entity context menu">
        <gz-gui>
          <property key="state" type="string">floating</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="CameraTracking" name="Camera Tracking">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="MarkerManager" name="Marker manager">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="SelectEntities" name="Select Entities">
        <gz-gui>
          <anchors target="Select entities">
            <line own="right" target="right"/>
            <line own="top" target="top"/>
          </anchors>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="VisualizationCapabilities" name="Visualization Capabilities">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="Spawn" name="Spawn Entities">
        <gz-gui>
          <anchors target="Select entities">
            <line own="right" target="right"/>
            <line own="top" target="top"/>
          </anchors>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin name="World control" filename="WorldControl">
        <gz-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">0</property>
          <property type="bool" key="resizable">0</property>
          <property type="double" key="height">72</property>
          <property type="double" key="width">121</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <play_pause>1</play_pause>
        <step>1</step>
        <start_paused>1</start_paused>
      </plugin>
      <plugin name="World stats" filename="WorldStats">
        <gz-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">0</property>
          <property type="bool" key="resizable">0</property>
          <property type="double" key="height">110</property>
          <property type="double" key="width">290</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <sim_time>1</sim_time>
        <real_time>1</real_time>
        <real_time_factor>1</real_time_factor>
        <iterations>1</iterations>
      </plugin>
      <plugin name="Entity tree" filename="EntityTree"/>
    </gui>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <grid>false</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1 1</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
        <pose>0 0 0 0 -0 0</pose>
        <inertial>
          <pose>0 0 0 0 -0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <enable_wind>false</enable_wind>
      </link>
      <pose>0 0 0 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>
    <light name="sunUTC" type="directional">
      <pose>0 0 500 0 -0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>0.904 0.904 0.904 1</diffuse>
      <specular>0.271 0.271 0.271 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>

    <!-- ЦЕЛЬ СЛЕЖЕНИЯ (Фаза 3, инкремент 4B).
         Ходячий Gazebo <actor> вместо статичной Standing person (инкр. 1). Скелетная
         анимация + <script><trajectory> — штатный механизм Gazebo, без плагинов/кода:
         сервер интерполирует позу актёра между waypoints. Меш walk.dae из Fuel-модели
         Mingfei/models/actor (тот же, что в штатном gz-sim8 worlds/actor.sdf) —
         скачивается при первом запуске, кэшируется в ~/.gz/fuel, в git не коммитим.

         z=1.0 в позах — начало скелета на уровне бёдер, ступни на земле (как в
         референсном actor.sdf). Дрон стартует в (0,0,0) носом на +X, камера mono_cam
         смотрит вперёд горизонтально (FOV≈100°) → цель ставим впереди по +X.

         У <actor> НЕТ <static> и физики/коллизий — это чисто визуальная цель, что для
         камеры/детектора и нужно.

         ДЕ-РИСК (4B-1) ПРОЙДЕН (2026-07-05): стоящий actor виден камерой и детектится
         YOLO как person (detected:true, offset_x≈0). Оба риска §9 закрыты.

         ШАГ 4B-2 (ходьба, сейчас): actor идёт по ЗАМКНУТОМУ КРУГУ, СМЕЩЁННОМУ ВПЕРЁД —
         центр (8,0), радиус 3 (человек проходит x=5..11, y=-3..3). ВАЖНО: круг НЕ центрирован
         на точке старта дрона (0,0) — иначе цель «вращалась» бы вокруг дрона и тому хватало
         бы одного разворота (дрон крутился бы на месте). Здесь человек ПЕРЕМЕЩАЕТСЯ по сцене
         → дрон вынужден ЛЕТЕТЬ следом (yaw+forward, Ф3-3, без бокового сноса).

         Скорость ~0.25 м/с (медленно): forward-канал контроллера нелинеен по площади bbox
         (area~1/d²), поэтому на дистанции реакция «вперёд» слабее — медленная цель даёт дрону
         уверенно поспевать. Круг проходится за ~72 с (окружность 2πR≈18.85 м / 0.25 м/с).

         Актёр повёрнут по направлению движения (yaw = касательная = φ+90°, φ — угол на круге).
         yaw задан НЕПРЕРЫВНО растущим (4.712→10.996 рад = +2π за круг) — линейная интерполяция
         даёт плавное вращение по часовой без рывков-перемоток. Траектория ЗАМКНУТА (t=72 совпа-
         дает с t=0 по позиции) → loop без телепорта. tension сглаживает круг.

         Позиции: φ=180°→(5,0); 225°→(5.88,-2.12); 270°→(8,-3); 315°→(10.12,-2.12);
                  0°→(11,0); 45°→(10.12,2.12); 90°→(8,3); 135°→(5.88,2.12). -->
    <actor name="target_person">
      <skin>
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walk">
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>0.0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walk" tension="0.6">
          <waypoint><time>0</time>  <pose>5.00   0.00 1.0 0 0 4.712</pose></waypoint>
          <waypoint><time>9</time>  <pose>5.88  -2.12 1.0 0 0 5.498</pose></waypoint>
          <waypoint><time>18</time> <pose>8.00  -3.00 1.0 0 0 6.283</pose></waypoint>
          <waypoint><time>27</time> <pose>10.12 -2.12 1.0 0 0 7.069</pose></waypoint>
          <waypoint><time>36</time> <pose>11.00  0.00 1.0 0 0 7.854</pose></waypoint>
          <waypoint><time>45</time> <pose>10.12  2.12 1.0 0 0 8.639</pose></waypoint>
          <waypoint><time>54</time> <pose>8.00   3.00 1.0 0 0 9.425</pose></waypoint>
          <waypoint><time>63</time> <pose>5.88   2.12 1.0 0 0 10.210</pose></waypoint>
          <waypoint><time>72</time> <pose>5.00   0.00 1.0 0 0 10.996</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg> 8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>
  </world>
</sdf>
