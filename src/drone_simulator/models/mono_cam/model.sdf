<?xml version="1.0" encoding="UTF-8"?>
<!--
  mono_cam (вендорная копия PX4-модели) — Фаза 4, Инкремент 6 / M3 (Ф4-4).

  Идентична PX4 Tools/simulation/gz/models/mono_cam/model.sdf, КРОМЕ поворота сенсора:
  <pose> сенсора imager стал `0 0 0 0 0.52 0` вместо `0 0 0 0 0 0` — камера смотрит
  ВНИЗ на ~30° (0.52 рад). Наклон — pitch вокруг Y: для камеры, глядящей вдоль +X,
  положительный pitch уводит оптическую ось к -Z (вниз).

  Зачем: снять «геометрическую стену» 4B/Ф3-7 — горизонтальная камера на 2.5 м роняла
  наземную цель из нижнего края кадра ближе ~3 м. Наклон возвращает цель в кадр на
  близкой дистанции → работает канал дистанции и pinhole-оценка (Ф4-5).

  Механизм подмены: этот каталог кладётся в GZ_SIM_RESOURCE_PATH ПЕРЕД моделями PX4
  (scripts/run_px4_sitl.sh) → gz резолвит model://mono_cam в ЭТУ модель. Имя (mono_cam)
  и интерфейс (link mono_cam/base_link, topic camera) сохранены — x500_mono_cam и
  CameraJoint из PX4 цепляются без изменений.

  Угол наклона живёт здесь, в ассете (как и траектории actor'ов в world-SDF). Если
  понадобится параметрический/управляемый наклон — это шаг активного gimbal (Ф4-4, R3).

  Intrinsics (horizontal_fov/размер) НЕ меняем — наклон это extrinsic, f_y из
  /camera/camera_info остаётся валиден для pinhole-дистанции.
-->
<sdf version='1.9'>
  <model name='mono_cam'>
    <pose>0 0 0 0 0 0</pose>
    <self_collide>false</self_collide>
    <static>false</static>
    <link name="mono_cam/base_link">
      <inertial>
        <pose>0.03 0.03 0.03 0 0 0</pose>
        <mass>0.050</mass>
        <inertia>
          <ixx>0.00004</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00004</iyy>
          <iyz>0</iyz>
          <izz>0.00004</izz>
        </inertia>
      </inertial>
      <sensor name="imager" type="camera">
        <pose>0 0 0 0 0.52 0</pose>
        <camera>
          <horizontal_fov>1.74</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>3000</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>camera</topic>
      </sensor>
      <gravity>true</gravity>
      <velocity_decay/>
    </link>
  </model>
</sdf>
