<?xml version="1.0"?>
<!-- Вендорная копия модели камеры PX4 (Tools/simulation/gz/models/mono_cam) с ОДНИМ
     отличием: сенсор наклонён вниз (Фаза 4, M3 / Ф4-4). Кладётся на GZ_SIM_RESOURCE_PATH
     ПЕРЕД моделями PX4 (см. scripts/run_px4_sitl.sh) → затеняет PX4-шный mono_cam, не
     трогая внешний git-ignored код. Имя модели ОБЯЗАНО совпадать (mono_cam), иначе
     x500_mono_cam не найдёт include model://mono_cam. -->
<model>
  <name>mono_cam</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>Markus Achtelik</name>
    <email>markus@auterion.com</email>
  </author>
  <description>Monocular camera tilted down (Phase 4 M3 vendored override)</description>
</model>
