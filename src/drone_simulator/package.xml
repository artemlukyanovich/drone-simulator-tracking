<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>drone_simulator</name>
  <version>0.0.0</version>
  <description>Запуск SITL, мосты, описание мира/дрона. Фаза 1 — пустой каркас, наполняется в Фазе 2.</description>
  <maintainer email="artemlukyanovich@gmail.com">artem</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>

  <!-- Мост камеры Gazebo → ROS2 (sim.launch.py). -->
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
