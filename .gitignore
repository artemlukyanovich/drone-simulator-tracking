# --- ROS2 / colcon (generated by build, never commit) ---
build/
install/
log/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
develop-eggs/

# --- Virtual environments ---
venv/
.venv/
env/
ENV/

# --- IDE / editors ---
.idea/
.vscode/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db

# --- Model weights (download / re-export, never commit) ---
*.pt
*.onnx
*.engine
*.pth

# --- Media (heavy, keep in assets/ or outputs/, not in git) ---
*.mp4
*.avi
*.mov
*.mkv
*.bag
*.mcap

# --- Logs ---
*.log

# --- Outputs (keep structure via .gitkeep, ignore contents) ---
outputs/**
!outputs/
!outputs/videos/
!outputs/logs/
!outputs/telemetry/
!outputs/**/.gitkeep
